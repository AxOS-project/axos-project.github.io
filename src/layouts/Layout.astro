---
import { ViewTransitions } from "astro:transitions";
import { pwaInfo } from "virtual:pwa-info";
import Footer from "@components/footer.astro";
import Navbar from "@components/navbar/navbar.astro";
import "@fontsource-variable/inter";
import { SEO } from "astro-seo";
export interface Props {
	title?: string;
	description?: string;
	image?: string;
	imageAlt?: string;
	type?: string;
	lang?: string;
}

const DEFAULT_DESCRIPTION = "The Linux experience, enhanced.";
const DEFAULT_IMAGE = "/meta/opengraph.png";
const DEFAULT_IMAGE_ALT = "The Linux experience, enhanced.";

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();

const {
	title,
	description = DEFAULT_DESCRIPTION,
	image = DEFAULT_IMAGE,
	imageAlt = DEFAULT_IMAGE_ALT,
	type = "website",
	lang = "en",
} = Astro.props;

const isDefaultImage = image === DEFAULT_IMAGE;
const resolvedImageWithDomain = new URL(image, Astro.site).toString();

const makeTitle = title
	? `${title} | AxOS`
	: "AxOS — The Linux experience, enhanced.";
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="alternate" type="application/rss+xml" title="AxOS" href={new URL("rss.xml", Astro.site)} />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#a855ff" />

		<ViewTransitions />

		<!-- Global CSS -->
		<link rel="stylesheet" href="/index.css" />

		<SEO
			title={makeTitle}
			description={description}
			canonical={canonicalURL}
			openGraph={{
				basic: {
					url: canonicalURL,
					type: type,
					title: makeTitle,
					image: resolvedImageWithDomain,
				},
				optional: {
					siteName: "AxOS",
					description: description,
				},
				image: {
					alt: imageAlt,
					...(isDefaultImage && {
						width: 1200,
						height: 630,
						type: "image/png",
					}),
				},
			}}
			twitter={{
				card: "summary_large_image",
				title: makeTitle,
				description: description,
				image: resolvedImageWithDomain,
				imageAlt: imageAlt,
			}}
		/>

		<script is:inline>
			function handleThemeChange() {
				if (localStorage.theme === "dark" || (!("theme" in localStorage) && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
					document.documentElement.classList.add("dark");
				} else {
					document.documentElement.classList.remove("dark");
				}
			}
			handleThemeChange();
			document.removeEventListener("astro:after-swap", handleThemeChange);
			document.addEventListener("astro:after-swap", handleThemeChange);
		</script>

		{pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
		<script src="/src/pwa.ts"></script>
	</head>
	<body class="dark:bg-stone-950">
		<Navbar />
		<slot />
		<Footer />
		<style is:global>
			/* Improve Page speed */
			/* https://css-tricks.com/almanac/properties/c/content-visibility/ */
			img {
				content-visibility: auto;
			}
		</style>
	</body>
</html>
