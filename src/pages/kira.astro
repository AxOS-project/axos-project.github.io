---
import Container from "@components/container.astro";
import Layout from "@layouts/Layout.astro";
---

<Layout title="AxOS × Kira Linux">
	<div class="relative isolate pt-14 dark:bg-stone-950 min-h-[calc(100vh-27rem)] flex items-center justify-center">
		<!-- Background glow effect -->
		<div class="absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-80">
			<svg
				class="relative left-[calc(50%-11rem)] -z-10 h-[21.1875rem] max-w-none -translate-x-1/2 rotate-[30deg] sm:left-[calc(50%-30rem)] sm:h-[42.375rem] animate-slide"
				viewBox="0 0 1155 678">
				<path
					fill="url(#glow-gradient)"
					fill-opacity=".3"
					d="M317.219 518.975L203.852 678 0 438.341l317.219 80.634 204.172-286.402c1.307 132.337 45.083 346.658 209.733 145.248C936.936 126.058 882.053-94.234 1031.02 41.331c119.18 108.451 130.68 295.337 121.53 375.223L855 299l21.173 362.054-558.954-142.079z">
				</path>
				<defs>
					<linearGradient
						id="glow-gradient"
						x1="1155.49"
						x2="-78.208"
						y1=".177"
						y2="474.645"
						gradientUnits="userSpaceOnUse">
						<stop stop-color="#a855ff"></stop>
						<stop offset="1" stop-color="#FFD580"></stop>
					</linearGradient>
				</defs>
			</svg>
		</div>

		<Container>
			<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col items-center text-center">
				<div class="flex items-center justify-center gap-4 mb-8">
					<h1 class="text-4xl font-bold tracking-tight text-black dark:text-white sm:text-6xl">
						AxOS
					</h1>
					<span class="text-3xl text-gray-400">×</span>
					<h1 class="text-4xl font-bold tracking-tight text-black dark:text-[#a855ff] sm:text-6xl">
						Kira
					</h1>
				</div>

				<p class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-300">
					A collaboration bringing the elegant <span class="font-semibold text-black dark:text-white">Sleex</span> desktop environment to <span class="font-semibold text-[#a855ff]">Kira Linux</span> as a first-class experience.
				</p>

				<p class="mt-4 text-md leading-7 text-gray-500 dark:text-gray-400">
					Kira Linux is a rolling-release, developer-oriented distribution designed for those who want to truly understand their system.
				</p>
				
				<div class="mt-10 flex flex-wrap items-center justify-center gap-6">
					<a
						href="https://kira-linux.com"
						target="_blank"
						rel="noopener noreferrer"
						class="text-sm font-semibold leading-6 text-gray-900 dark:text-white hover:text-[#a855ff] dark:hover:text-[#a855ff] transition-colors"
					>
						Kira Linux ↗
					</a>
					<a
						href="https://github.com/AxOS-project/Sleex"
						target="_blank"
						rel="noopener noreferrer"
						class="text-sm font-semibold leading-6 text-gray-900 dark:text-white hover:text-[#a855ff] dark:hover:text-[#a855ff] transition-colors"
					>
						Sleex ↗
					</a>
				</div>
			</div>
		</Container>
	</div>

	<style>
		@keyframes slide {
			0% { left: calc(50% - 70rem); transform: rotate(0deg); }
			50% { left: calc(50% - 30rem); transform: rotate(-180deg); }
			100% { left: calc(50% - 70rem); transform: rotate(0deg); }
		}
		.animate-slide { animation: slide 25s infinite; }
	</style>
</Layout>
